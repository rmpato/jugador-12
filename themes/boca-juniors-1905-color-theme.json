  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#4E6317",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language"
      ],
      "settings": {
        "foreground": "#002B5C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#2E1500",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "punctuation.definition.string"],
      "settings": {
        "foreground": "#8A1F0F"
      }
    },
    {
      "name": "String escapes and interpolation",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#A34A00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers and language constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#5B2A86"
      }
    },
    {
      "name": "User-defined constants",
      "scope": ["constant.other", "variable.other.constant"],
      "settings": {
        "foreground": "#5B2A86"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#7A1E5C"
      }
    },
    {
      "name": "Types, classes, interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#00615A"
      }
    },
    {
      "name": "Primitive/builtin types stay dark like keywords",
      "scope": [
        "support.type.primitive",
        "storage.type.numeric.go",
        "storage.type.byte.go",
        "storage.type.boolean.go",
        "storage.type.string.go",
        "storage.type.uintptr.go",
        "storage.type.error.go",
        "storage.type.rune.go",
        "storage.type.built-in.primitive"
      ],
      "settings": {
        "foreground": "#002B5C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Namespaces, modules and packages",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.other.namespace",
        "entity.name.package.go"
      ],
      "settings": {
        "foreground": "#00615A"
      }
    },
    {
      "name": "Properties and struct fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#0F5A7A"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": ["variable", "variable.parameter", "meta.definition.variable"],
      "settings": {
        "foreground": "#2E1500"
      }
    },
    {
      "name": "HTML/XML tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#002B5C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "HTML/XML attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#0F5A7A"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#002B5C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": "markup.italic",
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown strong",
      "scope": "markup.bold",
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#01418A"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#8A1F0F"
      }
    },
    {
      "name": "JSON property keys",
      "scope": "support.type.property-name.json",
      "settings": {
        "foreground": "#0F5A7A"
      }
    },
    {
      "name": "CSS property names",
      "scope": "support.type.property-name.css",
      "settings": {
        "foreground": "#2E1500"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#7A1E5C"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "foreground": "#8B1E2D",
        "fontStyle": "bold"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#00615A",
    "type": "#00615A",
    "type.defaultLibrary": { "foreground": "#002B5C", "bold": true },
    "class": "#00615A",
    "struct": "#00615A",
    "interface": "#00615A",
    "enum": "#00615A",
    "function": "#7A1E5C",
    "method": "#7A1E5C",
    "member": "#7A1E5C",
    "property": "#0F5A7A",
    "enumMember": "#5B2A86",
    "variable": "#2E1500",
    "parameter": "#2E1500",
    "keyword": { "foreground": "#002B5C", "bold": true },
    "string": "#8A1F0F",
    "number": "#5B2A86",
    "comment": { "foreground": "#4E6317", "italic": true }
  }
}
